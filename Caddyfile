{
	# TLS comes from the Cloudflare Origin Certificate below; never request ACME certs.
	auto_https disable_certs

	servers {
		# Requests arrive via Cloudflare: trust its edge IPs and log the real visitor IP.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

# Cloudflare proxies SITE_DOMAIN (from .env) to this server. Set Cloudflare SSL/TLS mode to
# "Full (strict)" and place the Origin Certificate + key in ./certs/ (see README).
{$SITE_DOMAIN} {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key

	log {
		output stdout
	}

	# Only Cloudflare may connect (stops anyone bypassing Cloudflare via the server IP).
	# private_ranges keeps local health checks working. Publish the port on IPv4 only
	# (e.g. 0.0.0.0:8448) so Docker's IPv6 proxy can't make outside clients look private.
	# Cloudflare ranges: https://www.cloudflare.com/ips/ (fetched 2026-11-12).
	@not_cloudflare not remote_ip private_ranges 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	abort @not_cloudflare

	encode zstd gzip

	# Django API. `handle` (not `handle_path`) keeps the /api prefix,
	# which Django's URL patterns expect (api/v1/...).
	handle /api/* {
		reverse_proxy backend:8000
	}

	# React single-page app: unknown paths fall back to index.html for client-side routing.
	handle {
		root * /srv/dist
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
